# spec.gmk is generated by configure and contains definitions used in this makefile

ifeq (,$(wildcard $(SPEC)))
  $(error OpenSSL.gmk needs SPEC set to a proper spec.gmk)
endif

include $(SPEC)
include MakeBase.gmk

ifeq ($(call isTargetOs, windows), true)
  # Configure normally demands that we use an implementation of perl that produces
  # paths with backslashes; CONFIGURE_INSIST bypasses that requirement.
  # PERL must be an absolute path that will be usable by nmake (i.e. start with
  # a drive letter and a colon).
  OPENSSL_CONFIG_SETUP := export CONFIGURE_INSIST=true PERL='$(shell $(PATHTOOL) -m $(PERL))' &&

  # Configure produces a makefile intended for use with nmake.
  OPENSSL_MAKE := nmake

  # MAKEFLAGS uses unix-style options (with a dash) which won't be understood by nmake.
  OPENSSL_MAKE_SETUP := export INCLUDE='$(OPENJ9_VS_INCLUDE)' LIB='$(OPENJ9_VS_LIB)' && unset MAKEFLAGS &&

  # The makefile produced by OpenSSL 3+ during the configure step needs to be
  # patched. Patching involves adding double-quotes around the name of perl
  # script files. For example,
  #   "$(PERL)" util/mkdef.pl
  # must change to
  #   "$(PERL)" "util/mkdef.pl"
  # otherwise nmake appears not to invoke perl as intended.
  # Patching has no effect for earlier versions.
  OPENSSL_PATCH := \
	( $(CD) $(OPENSSL_DIR) \
		&& $(MV) -f makefile makefile.orig \
		&& $(SED) -e 's|\("$$(PERL)"\) \([A-Za-z0-9_/-]*\.pl\)|\1 "\2"|' < makefile.orig > makefile \
	)
else # windows
  OPENSSL_CONFIG_SETUP :=
  OPENSSL_MAKE := $(MAKE)
  OPENSSL_MAKE_SETUP :=
  OPENSSL_PATCH :=
endif # windows

# OpenSSL 4.1 adds crypto/aes/aes_cbc_vaes_intrinsic.c and
# crypto/aes/asm/aes-cbc-vaes-x86_64.pl, which require VAES/AVX-512 operand
# forms in the assembler. Per OpenSSL's INSTALL.md ("Notes on assembler modules
# compilation") VAES needs GNU as >= 2.30 (AVX512 needs >= 2.25); the system
# binutils in some build containers is older, which fails with
# "operand type mismatch for vaesdec". Using no-asm is not acceptable as it
# loses the assembler and intrinsic acceleration.
#
# Where the build container provides a newer binutils in a gcc devkit, e.g.
#   /usr/local/devkit/gcc-14.2.0-<suffix>/x86_64-linux-gnu/bin
# use it for OpenSSL only. If no such directory exists (or it has no assembler)
# OPENSSL_DEVKIT_BIN is empty and nothing below changes the build.
#
# Both PATH and COMPILER_PATH are set. PATH makes ar, ranlib and a bare as/ld
# visible. COMPILER_PATH makes gcc look for as and ld in that directory
# first (it is searched like gcc -B), which PATH alone does not guarantee
# because gcc searches its own installation directories before PATH. Being
# environment variables, they are inherited by everything run by Configure and
# make, including the assembler capability probe in aes-cbc-vaes-x86_64.pl
# (`$CC -Wa,-v ...`, run by make) which decides whether the VAES code is
# assembled, so detection and compilation agree. This also works with the
# ccache handling below, which only replaces CC and CXX.
OPENSSL_DEVKIT_BIN :=
ifeq ($(call isTargetOs, linux)+$(call isTargetCpu, x86_64), true+true)
  # Candidates: directories which exist and contain an assembler.
  OPENSSL_DEVKIT_BIN_CANDIDATES := $(foreach d, \
	$(wildcard /usr/local/devkit/gcc-14.2.0-*/$(OPENJDK_TARGET_CPU)-linux-gnu/bin), \
	$(if $(or $(wildcard $(d)/as), $(wildcard $(d)/*-linux-gnu-as)), $(d)))
  # sort is deterministic; use the highest match.
  OPENSSL_DEVKIT_BIN := $(lastword $(sort $(OPENSSL_DEVKIT_BIN_CANDIDATES)))
endif

ifneq (,$(OPENSSL_DEVKIT_BIN))
  OPENSSL_TOOLCHAIN_SETUP := export PATH='$(OPENSSL_DEVKIT_BIN)':"$$PATH" COMPILER_PATH='$(OPENSSL_DEVKIT_BIN)'$${COMPILER_PATH:+:$$COMPILER_PATH} &&
  OPENSSL_CONFIG_SETUP := $(OPENSSL_TOOLCHAIN_SETUP) $(OPENSSL_CONFIG_SETUP)
  OPENSSL_MAKE_SETUP := $(OPENSSL_TOOLCHAIN_SETUP) $(OPENSSL_MAKE_SETUP)
endif

# Identify the desired openssl target configuration.
export OPENSSL_LOCAL_CONFIG_DIR := $(call MixedPath,$(TOPDIR)/closed/openssl-conf)

ifeq ($(call isTargetOs, aix)+$(call isCompiler, clang), true+true)
  OPENSSL_TARGET := semeru-$(OPENJ9_PLATFORM_CODE)-clang
else ifeq ($(call isTargetOs, windows), true)
  OPENSSL_TARGET := VC-$(OPENJ9_PLATFORM_CODE)
else
  OPENSSL_TARGET := semeru-$(OPENJ9_PLATFORM_CODE)
endif

ifeq ($(call isTargetCpu, s390x), true)
  OPENSSL_CONFIG_CFLAGS := -march=z10
else
  OPENSSL_CONFIG_CFLAGS :=
endif

ifneq (,$(CCACHE))
  # If ccache is enabled and the environment contains either CC or CXX, their
  # values (as defined in this make) are propagated to the instance of make
  # which will build openssl causing it to fail. Instead, pass along CC and
  # CXX without the ccache wrapper.
  OPENSSL_MAKE += CC=$(ac_cv_prog_CC) CXX=$(ac_cv_prog_CXX)
endif # CCACHE

build_openssl :
	@$(ECHO) Compiling OpenSSL in $(OPENSSL_DIR) for $(OPENSSL_TARGET)$(if $(OPENSSL_CONFIG_CFLAGS), with additional CFLAGS $(OPENSSL_CONFIG_CFLAGS))
  # Diagnostics for the Jenkins log. The shell running recipes may have errexit
  # (-e) set, so "cmd ; true" does not protect against a failing cmd (the shell
  # exits before reaching true). Each command that can fail therefore ends with
  # "|| true" so that a non-zero exit status can never fail the build, e.g.
  # ls of a devkit directory which does not exist on s390x.
  ifeq ($(call isTargetOs, linux), true)
 @$(ECHO) "[OPENSSL-DEBUG] devkit bin directory: $(if $(OPENSSL_DEVKIT_BIN),$(OPENSSL_DEVKIT_BIN),<none found, using system toolchain>)" || true
 @$(ECHO) "[OPENSSL-DEBUG] ls -la /usr/local/devkit:" || true
 @ls -la /usr/local/devkit 2>&1 || true
 @$(ECHO) "[OPENSSL-DEBUG] ls -la /usr/local/devkit/gcc-14.2.0-*:" || true
 @ls -la /usr/local/devkit/gcc-14.2.0-* 2>&1 || true
 @$(ECHO) "[OPENSSL-DEBUG] ls -la /usr/local/devkit/gcc-14.2.0-*/*-linux-gnu/bin:" || true
 @ls -la /usr/local/devkit/gcc-14.2.0-*/*-linux-gnu/bin 2>&1 || true
 @$(ECHO) "[OPENSSL-DEBUG] PATH used by OpenSSL: $(if $(OPENSSL_DEVKIT_BIN),$(OPENSSL_DEVKIT_BIN):)$$PATH" || true
 @$(ECHO) "[OPENSSL-DEBUG] COMPILER_PATH used by OpenSSL: $(if $(OPENSSL_DEVKIT_BIN),$(OPENSSL_DEVKIT_BIN):)$$COMPILER_PATH" || true
 @for t in as ld gcc ; do \
  $(ECHO) "[OPENSSL-DEBUG] system $$t: $$(command -v $$t 2>&1 || true); version: $$($$t --version 2>&1 | head -n 1 || true)" || true ; \
 done || true
 @for t in as ld gcc ; do \
  if test -n '$(OPENSSL_DEVKIT_BIN)' && test -x '$(OPENSSL_DEVKIT_BIN)'/$$t ; then \
  	$(ECHO) "[OPENSSL-DEBUG] devkit $$t: $(OPENSSL_DEVKIT_BIN)/$$t; version: $$('$(OPENSSL_DEVKIT_BIN)'/$$t --version 2>&1 | head -n 1 || true)" || true ; \
  else \
  	$(ECHO) "[OPENSSL-DEBUG] devkit $$t: not available" || true ; \
  fi ; \
 done || true
 @for t in as ld gcc ; do \
  $(ECHO) "[OPENSSL-DEBUG] effective $$t: $$( $(OPENSSL_TOOLCHAIN_SETUP) command -v $$t 2>&1 || true )" || true ; \
 done || true
 @$(ECHO) "[OPENSSL-DEBUG] CC=$(CC)" || true
 @$(ECHO) "[OPENSSL-DEBUG] ac_cv_prog_CC=$(ac_cv_prog_CC)" || true
 @$(ECHO) "[OPENSSL-DEBUG] OPENSSL_MAKE=$(OPENSSL_MAKE)" || true
  endif # linux
	( $(OPENSSL_CONFIG_SETUP) $(CD) $(OPENSSL_DIR) && $(PERL) Configure $(OPENSSL_CONFIG_CFLAGS) $(OPENSSL_TARGET) no-makedepend no-tests no-winstore shared )
	$(OPENSSL_PATCH)
	+ ( $(OPENSSL_MAKE_SETUP) $(CD) $(OPENSSL_DIR) && $(OPENSSL_MAKE) )

.PHONY : build_openssl
